# Merge these public presentation settings into the backend deployment environment.
# Keep PRODUCT_BRAND_NAME aligned with ERP VITE_BRAND_NAME and portal
# NEXT_PUBLIC_PRODUCT_BRAND_NAME. Restart the backend after changing these values;
# rebuild both frontend applications after changing their public variables.
PRODUCT_BRAND_NAME=Wewigo

# Optional existing establishment override for portal notifications.
# Leave blank to use the product name. Legacy NEXT_PUBLIC_BRAND_NAME remains supported.
BRAND_NAME=

# Sender identity is independent from the software name.
# Configure a verified sender separately when enabling email delivery.
RESEND_FROM_EMAIL=
